rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['tripIds', 'lastActiveTripId'])
        && request.resource.data.tripIds is list
        && resource.data.tripIds is list
        && request.resource.data.tripIds.size() <= resource.data.tripIds.size();
    }

    match /trips/{tripId} {

      function tripSnap() {
        return get(/databases/$(database)/documents/trips/$(tripId)).data;
      }

      function isCoOrganiserFlag(memData) {
        return memData.get('isAdmin', false) == true
          || memData.get('admin', false) == true;
      }

      function isTripLeaderUid(uid) {
        return exists(/databases/$(database)/documents/trips/$(tripId))
          && (tripSnap().adminId == uid
            || (exists(/databases/$(database)/documents/trips/$(tripId)/members/$(uid))
              && isCoOrganiserFlag(
                get(/databases/$(database)/documents/trips/$(tripId)/members/$(uid)).data)));
      }

      function isTripLeaderAuth() {
        return isAuthenticated() && isTripLeaderUid(request.auth.uid);
      }

      // Join-by-code — only memberIds grows by self
      function isJoiningTrip() {
        return isAuthenticated()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds is list
          && resource.data.memberIds is list
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.hasAny([request.auth.uid]);
      }

      function isLeavingTripUpdate() {
        return request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds'])
          && resource.data.memberIds is list
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.auth.uid in resource.data.memberIds;
      }

      function isOrganiserRemovingOther() {
        return request.auth.uid == resource.data.adminId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['memberIds'])
          && resource.data.memberIds is list
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds;
      }

      function isLeaderTripDetailsUpdate() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return isTripLeaderAuth()
          && changed.hasOnly([
            'name', 'destination', 'description',
            'startDate', 'endDate', 'budget', 'status'
          ]);
      }

      function isTransferAdminUpdateSafe() {
        return request.resource.data.diff(resource.data).changedKeys().hasOnly(['adminId', 'memberIds'])
          && request.auth.uid == resource.data.adminId
          && resource.data.memberIds is list
          && request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.adminId is string
          && request.resource.data.adminId != resource.data.adminId
          && request.resource.data.adminId in request.resource.data.memberIds;
      }

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.adminId == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.adminId == request.auth.uid;

      allow update: if isJoiningTrip()
        || isLeavingTripUpdate()
        || isOrganiserRemovingOther()
        || isLeaderTripDetailsUpdate()
        || isTransferAdminUpdateSafe();

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && (
            request.auth.uid == memberId
            || tripSnap().adminId == request.auth.uid
          );
      }

      match /expenses/{expenseId} {
        function expenseTripMember() {
          return request.auth.uid in tripSnap().memberIds;
        }

        allow read: if isAuthenticated() && expenseTripMember();

        allow create: if isAuthenticated()
          && expenseTripMember()
          && request.resource.data.createdBy == request.auth.uid;

        allow delete: if isAuthenticated()
          && expenseTripMember()
          && (
            isTripLeaderUid(request.auth.uid)
            || resource.data.get('createdBy', '') == request.auth.uid
          );

        allow update: if isAuthenticated()
          && expenseTripMember()
          && (
            (
              isTripLeaderUid(request.auth.uid)
              && request.resource.data.createdBy == resource.data.get('createdBy', '')
            )
            || (
              resource.data.get('createdBy', '') == request.auth.uid
              && request.resource.data.createdBy == resource.data.get('createdBy', '')
              && request.resource.data.settled == resource.data.get('settled', false)
            )
          );
      }

      match /tasks/{taskId} {
        function taskTripMember() {
          return request.auth.uid in tripSnap().memberIds;
        }

        function taskAppliesToUserForDeadline() {
          let a = resource.data.get('assignedTo', '');
          return a == 'everyone' || a == '' || a == request.auth.uid;
        }

        function isDeadlineNotifiedBumpOnly() {
          return request.resource.data.diff(resource.data).changedKeys().hasOnly(['deadlineNotified'])
            && resource.data.get('deadlineNotified', false) == false
            && request.resource.data.deadlineNotified == true;
        }

        allow read: if isAuthenticated() && taskTripMember();

        allow create: if isAuthenticated()
          && taskTripMember()
          && request.resource.data.createdBy == request.auth.uid;

        allow delete: if isAuthenticated()
          && taskTripMember()
          && (
            isTripLeaderUid(request.auth.uid)
            || resource.data.get('createdBy', '') == request.auth.uid
          );

        allow update: if isAuthenticated()
          && taskTripMember()
          && (
            (
              isTripLeaderUid(request.auth.uid)
              && request.resource.data.createdBy == resource.data.get('createdBy', '')
            )
            || (
              resource.data.get('createdBy', '') == request.auth.uid
              && request.resource.data.createdBy == resource.data.get('createdBy', '')
              && request.resource.data.completed == resource.data.get('completed', false)
            )
            || (
              isDeadlineNotifiedBumpOnly()
              && taskAppliesToUserForDeadline()
            )
          );
      }

      match /meta/{metaId} {
        allow read, write: if isAuthenticated()
          && request.auth.uid in tripSnap().memberIds;
      }

      match /fanoutNotifications/{notificationId} {
        allow read, create, delete: if isAuthenticated()
          && request.auth.uid in tripSnap().memberIds;
        allow update: if false;
      }
    }
  }
}
