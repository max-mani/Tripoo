rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Trip rules
    match /trips/{tripId} {
      // Any authenticated user can read a trip (needed to validate join codes)
      allow read: if request.auth != null;

      // Only trip members can write to the trip document
      allow write: if request.auth != null &&
        request.auth.uid in resource.data.memberIds;

      // Anyone authenticated can create a new trip
      allow create: if request.auth != null;

      // Members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          (request.auth.uid == memberId ||
           get(/databases/$(database)/documents/trips/$(tripId)).data.adminId == request.auth.uid);
      }

      // Expenses subcollection — any trip member can read/write
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }

      // Tasks subcollection — any trip member can read/write
      match /tasks/{taskId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
      }
    }
  }
}

