# Sample for local development. Copy to .env.local and fill from Firebase Console
# (Project settings → Your apps → Web app config). Do not commit .env.local.
#
# Netlify: set the same VITE_* keys under Site configuration → Environment variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=
