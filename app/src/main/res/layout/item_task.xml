<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Row content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <!-- Custom checkbox -->
        <FrameLayout
            android:id="@+id/flCheckbox"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:background="@drawable/bg_task_checkbox">

            <ImageView
                android:id="@+id/ivCheck"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Task info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/tripoo_text_primary"
                tools:text="Book hotel" />

            <TextView
                android:id="@+id/tvAssigned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:textColor="@color/tripoo_text_secondary"
                tools:text="Assigned to Everyone" />

            <TextView
                android:id="@+id/tvTaskNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="@color/tripoo_text_secondary"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="Remember to confirm by 5pm"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Assignee: group icon (everyone) or initial letter -->
        <FrameLayout
            android:id="@+id/flAssigneeBadge"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/ivAssigneeGroup"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:src="@drawable/ic_group"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                app:tint="#F48C25" />

            <TextView
                android:id="@+id/tvAssigneeAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/tripoo_orange"
                android:background="@android:color/transparent"
                tools:text="J" />
        </FrameLayout>

        <!-- More menu button (edit/delete) -->
        <ImageButton
            android:id="@+id/btnTaskMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_more_horiz"
            android:tint="@color/tripoo_text_hint"
            android:scaleType="center"
            android:contentDescription="@string/more_options" />

    </LinearLayout>

    <!-- Divider between rows in same group -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tripoo_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp" />

</LinearLayout>
