<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tripoo_text_primary"
            android:textSize="13sp"
            tools:ignore="HardcodedText"
            tools:text="Alex paid you ₹200" />

        <TextView
            android:id="@+id/tvHistoryMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tripoo_text_secondary"
            android:textSize="11sp"
            tools:ignore="HardcodedText"
            tools:text="12 Jun · optional note" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnHistoryDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete"
        android:padding="8dp"
        android:src="@drawable/ic_delete_forever"
        android:tint="@color/tripoo_text_hint"
        tools:ignore="HardcodedText" />
</LinearLayout>
