<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Expense"
            android:textColor="@color/tripoo_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_close_btn"
            android:contentDescription="@string/close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="#181411" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#14F48C25" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp">

            <!-- Amount -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="AMOUNT"
                android:letterSpacing="0.12"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_outline">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="16dp"
                    android:text="₹"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#8A7560" />

                <EditText
                    android:id="@+id/etAmount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:inputType="numberDecimal"
                    android:hint="0.00"
                    android:paddingStart="46dp"
                    android:paddingEnd="16dp"
                    android:textColor="#181411"
                    android:textColorHint="#BBA898"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:ignore="Autofill,HardcodedText" />
            </FrameLayout>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="DESCRIPTION"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescription"
                style="@style/Tripoo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/ic_receipt"
                app:startIconTint="#8A7560">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Hotel booking, Dinner, Taxi..."
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="CATEGORY"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <GridLayout
                android:id="@+id/gridCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:useDefaultMargins="false"
                android:rowCount="2" />

            <!-- Paid By -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="PAID BY"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <!--
                Custom dropdown row: person icon | selected name | chevron-down
                Tap opens a PopupMenu — same style as the expense-row "more" menu.
            -->
            <FrameLayout
                android:id="@+id/containerPaidBy"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    android:src="@drawable/ic_person"
                    android:tint="#8A7560"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvPaidBySelected"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="44dp"
                    android:paddingEnd="40dp"
                    android:gravity="center_vertical"
                    android:textColor="#181411"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="13dp"
                    android:src="@drawable/ic_expand_more"
                    android:tint="#8A7560"
                    android:contentDescription="@null" />
            </FrameLayout>

            <!-- Split toggle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="SPLIT"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:id="@+id/layoutSplitOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- ic_group = "group" icon (Equally) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSplitEqually"
                    style="@style/Tripoo.Button.Outline.Small"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="Equally"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_group"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconPadding="2dp"
                    tools:ignore="HardcodedText" />

                <!-- ic_tune = "tune" icon (Custom) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSplitCustom"
                    style="@style/Tripoo.Button.Outline.Small"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="Custom"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_tune"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconPadding="2dp"
                    tools:ignore="HardcodedText" />

                <!-- ic_person = "person" icon (Just Me) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSplitJustMe"
                    style="@style/Tripoo.Button.Outline.Small"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:text="Just Me"
                    android:textSize="10sp"
                    app:icon="@drawable/ic_person"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconPadding="1dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- Split With member chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="SPLIT WITH"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMembers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="DATE"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Tripoo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconTint="#8A7560">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select date"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Note -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="NOTE (OPTIONAL)"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Tripoo.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Any extra details...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="4"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    tools:ignore="HardcodedText" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddExpense"
                style="@style/Tripoo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Add Expense"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
