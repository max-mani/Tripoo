<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/tripoo_surface">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Task"
            android:textColor="@color/tripoo_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontWeight="800"
            tools:ignore="HardcodedText" />

        <FrameLayout
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@color/tripoo_bg"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                style="@style/Tripoo.Icon"
                android:text="close"
                android:textColor="@color/tripoo_text_secondary"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tripoo_border_light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:maxHeight="450dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="Task Name"
                android:layout_marginBottom="7dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    style="@style/Tripoo.Icon"
                    android:text="checklist"
                    android:textColor="@color/tripoo_text_secondary"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="14dp"
                    android:background="@android:color/transparent"
                    android:hint="e.g. Book Airport Transfer"
                    android:inputType="text"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    android:singleLine="true"
                    tools:text="Book hotel" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="Category"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="Assign To"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/assignContainer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    style="@style/Tripoo.Icon"
                    android:text="person"
                    android:textColor="@color/tripoo_text_secondary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/etAssignedTo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    tools:text="Everyone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="Due Date (optional)"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp" />

            <FrameLayout
                android:id="@+id/dateContainer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    style="@style/Tripoo.Icon"
                    android:text="event"
                    android:textColor="@color/tripoo_text_secondary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/etDueDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:inputType="none"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    tools:text="Select date" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="Priority"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/prioLow"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@color/tripoo_green"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripoo_text_secondary"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/prioMedium"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_chip_on"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="#D97706"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripoo_surface"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/prioHigh"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_input_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@color/tripoo_red"
                            android:layout_marginEnd="5dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripoo_text_secondary"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="Notes (optional)"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:background="@drawable/bg_input_outline"
                android:padding="12dp"
                android:hint="Any details or reminders..."
                android:inputType="textMultiLine"
                android:textColor="@color/tripoo_text_primary"
                android:textColorHint="#BBA898"
                android:textSize="15sp"
                android:gravity="top" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTask"
                style="@style/Tripoo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Add Task"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
