<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Add Task"
            android:textColor="@color/tripoo_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_close_btn"
            android:contentDescription="@string/close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="#181411" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#14F48C25" />

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="32dp">

            <!-- ── Task Name ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="TASK NAME"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_checklist"
                    app:tint="#8A7560" />

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="14dp"
                    android:background="@android:color/transparent"
                    android:hint="e.g. Book Airport Transfer"
                    android:inputType="textCapSentences"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    android:singleLine="true"
                    tools:ignore="HardcodedText,Autofill" />
            </FrameLayout>

            <!-- ── Category ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="CATEGORY"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_label"
                    app:tint="#8A7560" />

                <AutoCompleteTextView
                    android:id="@+id/actvCategory"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="40dp"
                    android:background="@android:color/transparent"
                    android:inputType="none"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    android:hint="Select category"
                    tools:ignore="HardcodedText,LabelFor" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_expand_more"
                    app:tint="#8A7560" />
            </FrameLayout>

            <!-- ── Assign To ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="ASSIGN TO"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <!-- Everyone chip (full-width, 10dp corner) -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipEveryone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Everyone"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tripoo_text_primary"
                app:chipCornerRadius="10dp"
                app:chipMinHeight="50dp"
                app:chipBackgroundColor="#F8F7F5"
                app:chipStrokeColor="@color/tripoo_border"
                app:chipStrokeWidth="1.5dp"
                app:chipIcon="@drawable/ic_group"
                app:chipIconTint="@color/tripoo_text_secondary"
                app:chipIconSize="20dp"
                app:checkedIconVisible="false"
                android:checkable="true"
                android:checked="true"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <!-- Individual member chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAssignees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp" />

            <!-- ── Due Date ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="DUE DATE (OPTIONAL)"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:id="@+id/dateContainer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_outline"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="#8A7560" />

                <TextView
                    android:id="@+id/etDueDate"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="14dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/tripoo_text_primary"
                    android:textColorHint="#BBA898"
                    android:textSize="15sp"
                    android:hint="No due date"
                    tools:ignore="HardcodedText" />
            </FrameLayout>

            <!-- ── Priority ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="PRIORITY"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Low -->
                <FrameLayout
                    android:id="@+id/prioLow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:id="@+id/prioDotLow"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_circle_low_prio" />

                        <TextView
                            android:id="@+id/tvPrioLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripoo_text_secondary"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Medium -->
                <FrameLayout
                    android:id="@+id/prioMedium"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_input_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:id="@+id/prioDotMedium"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_circle_medium_prio" />

                        <TextView
                            android:id="@+id/tvPrioMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripoo_text_secondary"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </FrameLayout>

                <!-- High -->
                <FrameLayout
                    android:id="@+id/prioHigh"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_input_outline"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <View
                            android:id="@+id/prioDotHigh"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_circle_high_prio" />

                        <TextView
                            android:id="@+id/tvPrioHigh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/tripoo_text_secondary"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- ── Notes (optional) ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Text.SectionLabel"
                android:text="NOTES (OPTIONAL)"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="7dp"
                tools:ignore="HardcodedText" />

            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:maxLines="5"
                android:background="@drawable/bg_input_outline"
                android:padding="12dp"
                android:hint="Any details or reminders..."
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="@color/tripoo_text_primary"
                android:textColorHint="#BBA898"
                android:textSize="15sp"
                android:gravity="top|start"
                tools:ignore="HardcodedText,Autofill" />

            <!-- ── Submit button ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveTask"
                style="@style/Tripoo.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Add Task"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_add_task"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@android:color/white"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
