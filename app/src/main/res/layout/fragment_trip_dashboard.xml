<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tripoo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tripoo_surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="50dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Tripoo.Icon"
                android:text="rocket_launch"
                android:textColor="@color/tripoo_orange"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Tripoo"
                android:textColor="@color/tripoo_text_primary"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textFontWeight="900"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:id="@+id/btnProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="0dp"
                android:layout_marginLeft="0dp"
                android:layout_gravity="end"
                android:layout_weight="1"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_circle_orange"
                    android:gravity="center"
                    android:text="FN"
                    android:textColor="@color/tripoo_surface"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textFontWeight="900"
                    tools:ignore="HardcodedText" />
            </FrameLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Greeting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hey Faizal 👋"
                        android:textColor="@color/tripoo_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textFontWeight="800"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="You have 2 active trips"
                        android:textColor="@color/tripoo_text_secondary"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Filter chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_on"
                            android:text="All Trips"
                            android:textColor="@color/tripoo_surface"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textFontWeight="600"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/chipActive"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/bg_chip_off"
                            android:text="Active"
                            android:textColor="@color/tripoo_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textFontWeight="600"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/chipUpcoming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/bg_chip_off"
                            android:text="Upcoming"
                            android:textColor="@color/tripoo_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textFontWeight="600"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:id="@+id/chipPast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:background="@drawable/bg_chip_off"
                            android:text="Past"
                            android:textColor="@color/tripoo_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textFontWeight="600"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Tripoo.Text.SectionLabel"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:text="Your Trips"
                    tools:ignore="HardcodedText" />

                <!-- Trip cards (static demo content for now, same as HTML) -->
                <LinearLayout
                    android:id="@+id/cardActiveTrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="11dp"
                    android:background="@drawable/bg_trip_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="@color/tripoo_status_active_bar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="11dp"
                        android:paddingTop="13dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="13dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Summer in Bali 🌴"
                                android:textColor="@color/tripoo_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@color/tripoo_status_active_bg"
                                android:text="Active"
                                android:textColor="@color/tripoo_status_active_text"
                                android:textSize="11sp"
                                android:paddingStart="9dp"
                                android:paddingEnd="9dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Tripoo.Icon"
                                android:text="location_on"
                                android:textColor="@color/tripoo_text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="Bali, Indonesia"
                                android:textColor="@color/tripoo_text_secondary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/Tripoo.Icon"
                                android:text="calendar_today"
                                android:textColor="@color/tripoo_text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="Jul 15 – Jul 30, 2025"
                                android:textColor="@color/tripoo_text_secondary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="·"
                                android:textColor="@color/tripoo_text_secondary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                style="@style/Tripoo.Icon"
                                android:text="group"
                                android:textColor="@color/tripoo_text_hint"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="8 members"
                                android:textColor="@color/tripoo_text_secondary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:indeterminate="false"
                            app:indicatorColor="@color/tripoo_orange"
                            app:trackColor="@color/tripoo_orange_12"
                            app:trackCornerRadius="999dp"
                            app:trackThickness="8dp"
                            android:progress="49" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="₹2,450 / ₹5,000 budget"
                                android:textColor="@color/tripoo_text_secondary"
                                android:textSize="11sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="51% left"
                                android:textColor="@color/tripoo_orange"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinTrip"
                        style="@style/Tripoo.Button.Outline.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Join Trip"
                        android:textColor="@color/tripoo_orange"
                        app:strokeColor="@color/tripoo_orange"
                        app:icon="@drawable/ic_add_link"
                        app:iconGravity="textStart"
                        app:iconTint="@color/tripoo_orange"
                        app:iconPadding="6dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewTrip"
                        style="@style/Tripoo.Button.Primary.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="New Trip"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@color/tripoo_surface"
                        app:iconPadding="6dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
