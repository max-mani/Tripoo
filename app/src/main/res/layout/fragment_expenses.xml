<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tripoo_bg"
    tools:context=".ui.expenses.ExpensesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Topbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tripoo_surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="50dp"
            android:paddingBottom="13dp"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_orange_lt"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/tripoo_orange"
                    android:contentDescription="@string/back"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvTripName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bali Trip"
                    android:textColor="@color/tripoo_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
                <TextView
                    android:id="@+id/tvTripSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="8 participants · Jul 15–30"
                    android:textColor="@color/tripoo_text_secondary"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <FrameLayout
                    android:id="@+id/btnSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_orange_lt"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_search"
                        android:tint="@color/tripoo_orange"
                        android:contentDescription="@string/search" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnMore"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle_orange_lt"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_more_horiz"
                        android:tint="@color/tripoo_orange"
                        android:contentDescription="@string/more_options" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Balances -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@color/tripoo_surface"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/tripoo_red_bg"
                app:strokeColor="@color/tripoo_red_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOU OWE"
                        android:textColor="#B91C1C"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvYouOwe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₹0"
                        android:textColor="@color/tripoo_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_trending_down"
                            android:tint="@color/tripoo_red"
                            android:contentDescription="@string/trending_down" />
                        <TextView
                            android:id="@+id/tvOweTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vs last week"
                            android:textColor="@color/tripoo_red"
                            android:textSize="10sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/tripoo_orange_12"
                app:strokeColor="#33F48C25"
                app:strokeWidth="1dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOU ARE OWED"
                        android:textColor="@color/tripoo_orange_dark"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tvYouAreOwed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₹0"
                        android:textColor="@color/tripoo_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_trending_up"
                            android:tint="@color/tripoo_green"
                            android:contentDescription="@string/trending_up" />
                        <TextView
                            android:id="@+id/tvOwedTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vs last week"
                            android:textColor="@color/tripoo_green"
                            android:textSize="10sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/tripoo_surface"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/layoutTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabAll"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="All Expenses"
                        android:textColor="@color/tripoo_orange"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <View
                        android:id="@+id/indAll"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/tripoo_orange"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabMy"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="My Spending"
                        android:textColor="@color/tripoo_text_hint"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <View
                        android:id="@+id/indMy"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/tripoo_orange"
                        android:visibility="invisible"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabSettled"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Settled"
                        android:textColor="@color/tripoo_text_hint"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <View
                        android:id="@+id/indSettled"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/tripoo_orange"
                        android:visibility="invisible"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tabStats"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Stats"
                        android:textColor="@color/tripoo_text_hint"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <View
                        android:id="@+id/indStats"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/tripoo_orange"
                        android:visibility="invisible"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/etSearchExpenses"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_outline"
            android:hint="Search expenses"
            android:textColor="@color/tripoo_text_primary"
            android:textColorHint="@color/tripoo_text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="13sp"
            android:visibility="gone"/>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshExpenses"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tripoo_section_bg">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExpenses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tripoo_section_bg"
                android:clipToPadding="false"
                android:paddingBottom="142dp"
                tools:listitem="@layout/item_expense" />

            <TextView
                android:id="@+id/emptyExpenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="8dp"
                android:drawableTop="@drawable/ic_receipt"
                android:gravity="center"
                android:text="No expenses found"
                android:textColor="@color/tripoo_status_past_text"
                android:textSize="12sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/statsContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="184dp"
                android:visibility="gone">

                <include
                    android:id="@+id/viewStats"
                    layout="@layout/view_expense_stats"/>
            </androidx.core.widget.NestedScrollView>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewTripGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tripoo_section_bg"
            app:adSize="BANNER"
            app:adUnitId="@string/admob_banner_trip_group" />

        <!-- Bottom nav -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_bnav"
            android:orientation="horizontal"
            android:gravity="top"
            android:paddingTop="9dp"
            android:paddingBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_home_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_text_hint"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navExpenses"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavExpenses"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_expense_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expenses"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_orange"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavTasks"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_tasks_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasks"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_text_hint"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navGroups"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavGroups"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_groups_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavGroups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groups"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_text_hint"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddExpense"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="138dp"
        android:contentDescription="@string/add_expense"
        app:backgroundTint="@color/tripoo_orange"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Tripoo.FabCircle"
        app:tint="@color/tripoo_surface"
        app:elevation="8dp"
        app:pressedTranslationZ="12dp"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
