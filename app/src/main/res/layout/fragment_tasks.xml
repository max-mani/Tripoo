<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tripoo_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Frosted header -->
        <LinearLayout
            android:id="@+id/tasksHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E8FFFFFF"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="50dp"
            android:paddingBottom="14dp">

            <!-- Row 1: Trip name + Avatar stack + Search button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="11dp">

                <!-- Left: rocket icon + trip name -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:src="@drawable/ic_logo_rocket"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvTasksTripName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/tripoo_text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Avatar stack (built programmatically) -->
                <LinearLayout
                    android:id="@+id/llAvatarStack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />

                <!-- Search button -->
                <FrameLayout
                    android:id="@+id/btnSearch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_circle_orange_lt"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_search"
                        android:tint="@color/tripoo_orange"
                        android:contentDescription="@string/search" />
                </FrameLayout>

            </LinearLayout>

            <!-- Row 2: Progress label + percentage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trip Completion"
                    android:textSize="13sp"
                    android:textColor="@color/tripoo_text_secondary" />

                <TextView
                    android:id="@+id/tvProgressPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripoo_orange" />

            </LinearLayout>

            <!-- Row 3: Progress bar -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressTasks"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                app:indicatorColor="@color/tripoo_orange"
                app:trackColor="#E8E4DF"
                app:trackCornerRadius="999dp"
                app:trackThickness="10dp" />

            <!-- Row 4: Progress note -->
            <TextView
                android:id="@+id/tvProgressNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0 of 0 tasks completed"
                android:textSize="11sp"
                android:textColor="@color/tripoo_text_secondary" />

        </LinearLayout>

        <!-- Bottom border for header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E6E0DB" />

        <!-- Tab row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:background="@color/tripoo_surface"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Tab: All -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/taskTabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="All"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripoo_orange" />

                <View
                    android:id="@+id/indTaskAll"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/tripoo_orange"
                    android:visibility="visible" />

            </LinearLayout>

            <!-- Tab: In Progress -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/taskTabProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="In Progress"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripoo_text_hint" />

                <View
                    android:id="@+id/indTaskProgress"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/tripoo_orange"
                    android:visibility="invisible" />

            </LinearLayout>

            <!-- Tab: Completed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/taskTabDone"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Completed"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tripoo_text_hint" />

                <View
                    android:id="@+id/indTaskDone"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="@color/tripoo_orange"
                    android:visibility="invisible" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tab row bottom border -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F4F6" />

        <!-- Search field (hidden until search icon tapped) -->
        <EditText
            android:id="@+id/etSearchTasks"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_outline"
            android:hint="Search tasks…"
            android:textColor="@color/tripoo_text_primary"
            android:textColorHint="@color/tripoo_text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="13sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:visibility="gone" />

        <!-- Task list with pull-to-refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshTasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTasks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/tripoo_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="142dp"
                    android:clipToPadding="false" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/emptyTasks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_tasks"
                        android:alpha="0.35"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No tasks yet"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tripoo_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Tap + to add a task for this trip"
                        android:textSize="13sp"
                        android:textColor="@color/tripoo_text_hint" />

                </LinearLayout>

            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.google.android.gms.ads.AdView
            android:id="@+id/adViewTripGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tripoo_bg"
            app:adSize="BANNER"
            app:adUnitId="@string/admob_banner_trip_group" />

        <!-- Bottom nav -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_bnav"
            android:orientation="horizontal"
            android:gravity="top"
            android:paddingTop="9dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_home_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_text_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navExpenses"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavExpenses"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_expense_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavExpenses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expenses"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_text_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navTasks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavTasks"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_tasks_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasks"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_orange" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navGroups"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/ivNavGroups"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/nav_groups_selector"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tvNavGroups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Groups"
                    android:textAllCaps="true"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/tripoo_text_hint" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="138dp"
        android:contentDescription="@string/add_task"
        app:backgroundTint="@color/tripoo_orange"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Tripoo.FabCircle"
        app:tint="@color/tripoo_surface"
        app:elevation="8dp"
        app:pressedTranslationZ="12dp"
        app:srcCompat="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
