<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/tripoo_surface"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center_vertical">

    <!-- Category icon box -->
    <FrameLayout
        android:id="@+id/flCategoryIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_category_icon_box"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/ivCategory"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            tools:src="@drawable/ic_home" />
    </FrameLayout>

    <!-- Middle info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExpenseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/tripoo_text_primary"
            tools:text="Villa Booking" />

        <TextView
            android:id="@+id/tvExpenseSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="#6B7280"
            tools:text="Paid by Alex · Split with Everyone" />
    </LinearLayout>

    <!-- Right amounts -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvExpenseTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/tripoo_text_primary"
            tools:text="₹500.00" />

        <TextView
            android:id="@+id/tvExpenseShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Your share: ₹62.50" />
    </LinearLayout>

</LinearLayout>
