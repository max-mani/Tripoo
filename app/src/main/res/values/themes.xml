<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tripoo theme: light and dark use identical colors -->
    <style name="Theme.Tripoo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tripoo_orange</item>
        <item name="colorPrimaryVariant">@color/tripoo_orange_dark</item>
        <item name="colorOnPrimary">@color/tripoo_surface</item>
        <item name="colorSecondary">@color/tripoo_orange</item>
        <item name="colorOnSecondary">@color/tripoo_surface</item>
        <item name="android:colorBackground">@color/tripoo_bg</item>
        <item name="colorSurface">@color/tripoo_surface</item>
        <item name="colorOnSurface">@color/tripoo_text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/tripoo_bg</item>
        <item name="android:statusBarColor">@color/tripoo_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomNavigationStyle">@style/Tripoo.BottomNav</item>
        <!-- Android 12+ splash: orange background + SVG logo with thin border for visibility -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_with_border</item>
        <item name="android:windowSplashScreenBackground">@color/tripoo_orange</item>
    </style>

    <!-- PopupMenu overlay: ensure visible text -->
    <style name="ThemeOverlay.Tripoo.PopupMenu" parent="">
        <item name="android:textColorPrimary">@color/tripoo_text_primary</item>
        <item name="android:textColorSecondary">@color/tripoo_text_secondary</item>
    </style>

    <!-- DatePickerDialog: MC alert base fixes OK/Cancel contrast; explicit header + buttons -->
    <style name="ThemeOverlay.Tripoo.DatePickerDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/tripoo_surface</item>
        <item name="android:colorBackground">@color/tripoo_surface</item>
        <item name="colorPrimary">@color/tripoo_orange</item>
        <item name="colorAccent">@color/tripoo_orange</item>
        <item name="android:colorAccent">@color/tripoo_orange</item>
        <item name="colorSurface">@color/tripoo_surface</item>
        <item name="colorOnSurface">@color/tripoo_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/tripoo_text_primary</item>
        <item name="android:textColorPrimary">@color/tripoo_text_primary</item>
        <item name="android:textColorSecondary">@color/tripoo_text_secondary</item>
        <item name="android:textColorPrimaryInverse">@color/tripoo_text_primary</item>
        <item name="android:textColorSecondaryInverse">@color/tripoo_text_secondary</item>
        <item name="android:colorControlActivated">@color/tripoo_orange</item>
        <item name="android:headerBackground">@color/tripoo_surface</item>
        <item name="android:headerMonthTextAppearance">@style/Tripoo.DatePickerHeaderMonth</item>
        <item name="android:headerYearTextAppearance">@style/Tripoo.DatePickerHeaderYear</item>
        <item name="android:headerDayOfMonthTextAppearance">@style/Tripoo.DatePickerHeaderDay</item>
        <item name="buttonBarPositiveButtonStyle">@style/Tripoo.DatePickerDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Tripoo.DatePickerDialog.Button</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Tripoo.DatePickerDialog.Button</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Tripoo.DatePickerDialog.Button</item>
    </style>

    <style name="Tripoo.DatePickerDialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog.Flush">
        <item name="android:textColor">@color/tripoo_orange</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/tripoo_orange_12</item>
    </style>

    <style name="Tripoo.DatePickerHeaderMonth" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/tripoo_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Tripoo.DatePickerHeaderYear" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/tripoo_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <style name="Tripoo.DatePickerHeaderDay" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/tripoo_text_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Tripoo.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Tripoo.BottomSheet</item>
    </style>

    <style name="Widget.Tripoo.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Tripoo.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Tripoo.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
    </style>

    <!-- Starting theme kept for compatibility but no longer used by MainActivity. -->
    <style name="Theme.Tripoo.Starting" parent="Theme.Tripoo">
        <item name="android:windowBackground">@color/tripoo_bg</item>
    </style>
</resources>
