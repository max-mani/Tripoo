<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tripoo theme: light and dark use identical colors -->
    <style name="Theme.Tripoo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tripoo_orange</item>
        <item name="colorPrimaryVariant">@color/tripoo_orange_dark</item>
        <item name="colorOnPrimary">@color/tripoo_surface</item>
        <item name="colorSecondary">@color/tripoo_orange</item>
        <item name="colorOnSecondary">@color/tripoo_surface</item>
        <item name="android:colorBackground">@color/tripoo_bg</item>
        <item name="colorSurface">@color/tripoo_surface</item>
        <item name="colorOnSurface">@color/tripoo_text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowBackground">@color/tripoo_bg</item>
        <item name="android:statusBarColor">@color/tripoo_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomNavigationStyle">@style/Tripoo.BottomNav</item>
        <!-- Android 12+ splash: orange background + SVG logo with thin border for visibility -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_with_border</item>
        <item name="android:windowSplashScreenBackground">@color/tripoo_orange</item>
    </style>

    <style name="Theme.Tripoo.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Tripoo.BottomSheet</item>
    </style>

    <style name="Widget.Tripoo.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Tripoo.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Tripoo.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
    </style>

    <!-- Starting theme kept for compatibility but no longer used by MainActivity. -->
    <style name="Theme.Tripoo.Starting" parent="Theme.Tripoo">
        <item name="android:windowBackground">@color/tripoo_bg</item>
    </style>
</resources>
