<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment android:id="@+id/splashFragment"
        android:name="com.manikandan.tripoo.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action android:id="@+id/action_splash_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_splash_to_dashboard"
            app:destination="@id/tripDashboardFragment"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/authFragment"
        android:name="com.manikandan.tripoo.ui.auth.AuthFragment"
        android:label="Login"
        tools:layout="@layout/fragment_auth">
        <action android:id="@+id/action_auth_to_signup" app:destination="@id/signUpFragment"/>
        <action android:id="@+id/action_auth_to_login" app:destination="@id/loginFragment"/>
        <action android:id="@+id/action_auth_to_dashboard"
            app:destination="@id/tripDashboardFragment"
            app:popUpTo="@id/authFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/signUpFragment"
        android:name="com.manikandan.tripoo.ui.auth.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_sign_up">
        <action android:id="@+id/action_signup_to_dashboard"
            app:destination="@id/tripDashboardFragment"
            app:popUpTo="@id/authFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/loginFragment"
        android:name="com.manikandan.tripoo.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action android:id="@+id/action_login_to_dashboard"
            app:destination="@id/tripDashboardFragment"
            app:popUpTo="@id/authFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/tripDashboardFragment"
        android:name="com.manikandan.tripoo.ui.dashboard.TripDashboardFragment"
        android:label="My Trips"
        tools:layout="@layout/fragment_trip_dashboard">
        <action android:id="@+id/action_dashboard_to_create" app:destination="@id/createTripFragment"/>
        <action android:id="@+id/action_dashboard_to_join" app:destination="@id/joinTripFragment"/>
        <action android:id="@+id/action_dashboard_to_home" app:destination="@id/homeFragment"/>
        <action android:id="@+id/action_dashboard_to_profile" app:destination="@id/profileFragment"/>
    </fragment>

    <fragment android:id="@+id/createTripFragment"
        android:name="com.manikandan.tripoo.ui.home.CreateTripFragment"
        android:label="Create Trip"
        tools:layout="@layout/fragment_create_trip">
        <action android:id="@+id/action_create_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/tripDashboardFragment"/>
    </fragment>

    <fragment android:id="@+id/joinTripFragment"
        android:name="com.manikandan.tripoo.ui.home.JoinTripFragment"
        android:label="Join Trip"
        tools:layout="@layout/fragment_join_trip">
        <action android:id="@+id/action_join_to_create" app:destination="@id/createTripFragment" app:popUpTo="@id/joinTripFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_join_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/tripDashboardFragment"/>
    </fragment>

    <fragment android:id="@+id/homeFragment"
        android:name="com.manikandan.tripoo.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <argument android:name="tripId" app:argType="string" android:defaultValue=""/>
        <action android:id="@+id/action_home_to_create_trip" app:destination="@id/createTripFragment"/>
        <action android:id="@+id/action_home_to_join_trip" app:destination="@id/joinTripFragment"/>
        <action android:id="@+id/action_home_to_expenses" app:destination="@id/expensesFragment"/>
        <action android:id="@+id/action_home_to_tasks" app:destination="@id/tasksFragment"/>
        <action android:id="@+id/action_home_to_participants" app:destination="@id/participantsFragment"/>
    </fragment>

    <fragment android:id="@+id/expensesFragment"
        android:name="com.manikandan.tripoo.ui.expenses.ExpensesFragment"
        android:label="Expenses"
        tools:layout="@layout/fragment_expenses">
        <argument android:name="tripId" app:argType="string" android:defaultValue=""/>
        <action android:id="@+id/action_expenses_to_tasks"
            app:destination="@id/tasksFragment"
            app:popUpTo="@id/homeFragment" />
        <action android:id="@+id/action_expenses_to_participants"
            app:destination="@id/participantsFragment"
            app:popUpTo="@id/homeFragment" />
    </fragment>

    <fragment android:id="@+id/tasksFragment"
        android:name="com.manikandan.tripoo.ui.tasks.TasksFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_tasks">
        <argument android:name="tripId" app:argType="string" android:defaultValue=""/>
    </fragment>

    <fragment android:id="@+id/participantsFragment"
        android:name="com.manikandan.tripoo.ui.groups.GroupsFragment"
        android:label="Participants"
        tools:layout="@layout/fragment_groups">
        <argument android:name="tripId" app:argType="string" android:defaultValue=""/>
    </fragment>

    <fragment android:id="@+id/profileFragment"
        android:name="com.manikandan.tripoo.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action android:id="@+id/action_profile_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/nav_graph" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_profile_to_dashboard" app:destination="@id/tripDashboardFragment"/>
    </fragment>

</navigation>
